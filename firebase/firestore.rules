rules_version = '2';

// EmptyHands — paste this into Firebase console → Firestore Database → Rules
// (or deploy it with `firebase deploy --only firestore:rules`).
// OWNERS must match OWNER_EMAILS in js/config.js (in both repositories).
service cloud.firestore {
  match /databases/{database}/documents {

    function OWNERS() { return ['info@emptyhands.co.uk']; }

    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function coachList() {
      return exists(/databases/$(database)/documents/settings/coaches)
        ? get(/databases/$(database)/documents/settings/coaches).data.emails : [];
    }
    function isCoach() {
      return signedIn() && (email() in OWNERS() || email() in coachList());
    }
    function isStudent() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }
    // The notice/homework groups this student belongs to (mirrors myAudiences() in js/common.js).
    function myAudiences() {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let d = p.get('dojo', '');
      return ['all'].concat(p.get('disciplines', []))
        .concat(d == 'ilford' || d == 'both' ? ['ilford'] : [])
        .concat(d == 'epping' || d == 'both' ? ['epping'] : [])
        .concat(p.get('grade', '') == 'dan' ? ['blackbelt'] : []);
    }

    // What a student may put in their own profile.
    function validProfile(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.get('guardian', '') is string && d.get('guardian', '').size() <= 120
        && d.get('phone', '') is string && d.get('phone', '').size() <= 40
        && d.disciplines is list && d.disciplines.size() <= 3 && d.disciplines.hasOnly(['karate', 'taichi', 'yoga'])
        && d.dojo in ['ilford', 'epping', 'both']
        && d.grade in ['none', 'red', 'orange', 'yellow', 'green', 'purple', 'purple1', 'brown', 'brown1', 'brown2', 'dan'];
    }

    // Student profiles. A new sign-up is a join request (role 'pending') until a coach
    // accepts it (role 'student') or declines it. Students can't change their own role,
    // and once accepted only Sensei can change their belt (grade).
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isCoach());
      // Sign-up: only the normal profile fields, as a join request.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'guardian', 'phone', 'disciplines', 'dojo', 'grade', 'email', 'role', 'createdAt', 'lastRead'])
        && request.resource.data.role == 'pending'
        && request.resource.data.email == email()
        && validProfile(request.resource.data);
      // Students can only change their own details and app state, never their role, exemption
      // or reminders; and once accepted, not their belt.
      allow update: if isCoach()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'guardian', 'phone', 'disciplines', 'dojo', 'grade', 'lastRead', 'seen', 'pushTokens', 'homeworkDone', 'classReminders'])
            && (resource.data.role == 'pending' || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['grade']))
            && validProfile(request.resource.data)
            && request.resource.data.get('pushTokens', []).size() <= 20
            && request.resource.data.get('classReminders', true) is bool);
      allow delete: if isCoach() || (signedIn() && request.auth.uid == uid);
    }

    // Notices: each accepted student reads only the ones for their groups; Sensei writes.
    match /notifications/{id} {
      allow read: if isCoach() || (isStudent() && resource.data.audience in myAudiences());
      allow create, update: if isCoach()
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 4000;
      allow delete: if isCoach();
    }

    // Editing a sent message: only its text changes (and it's marked as edited).
    function validEdit() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.editedAt == request.time;
    }

    // EmptyHands chats, private messages. chats/{studentUid} is shared by every Sensei;
    // chats/{studentUid}~{key} is with one Sensei, key being their email with anything but a-z and
    // 0-9 turned into _. The head Sensei (OWNERS) can read every chat, for safeguarding, but only
    // writes in their own and the shared ones.
    function myKey() { return email().replace('[^a-z0-9]', '_'); }
    function isOwner() { return signedIn() && email() in OWNERS(); }
    function tStudent(tid) { return tid.split('~')[0]; }
    function tSensei(tid) { return tid.split('~').size() > 1 ? tid.split('~')[1] : 'all'; }
    function coachSends(tid) { return isCoach() && (tSensei(tid) == 'all' || tSensei(tid) == myKey()); }
    function coachReads(tid) { return coachSends(tid) || (isCoach() && isOwner()); }
    function studentIn(tid) { return signedIn() && request.auth.uid == tStudent(tid) && isStudent(); }
    // The chat summary (for Sensei's list): students may only update their own side of it.
    // coachUnread (Sensei's unread count) can only go up by one per message.
    function studentChatWrite(tid, keys, before) {
      return studentIn(tid)
        && keys.hasOnly(['name', 'lastAt', 'lastFrom', 'lastText', 'studentReadAt', 'coachUnread', 'sensei', 'student'])
        && request.resource.data.get('lastFrom', 'student') == 'student'
        && request.resource.data.get('sensei', tSensei(tid)) == tSensei(tid)
        && request.resource.data.get('student', tStudent(tid)) == tStudent(tid)
        && (!keys.hasAny(['coachUnread']) || request.resource.data.coachUnread == before + 1);
    }
    match /chats/{tid} {
      allow read: if coachReads(tid) || studentIn(tid)
        || (isCoach() && resource.data.get('sensei', 'all') in ['all', myKey()]);
      allow write: if coachReads(tid)
        && request.resource.data.get('sensei', tSensei(tid)) == tSensei(tid)
        && request.resource.data.get('student', tStudent(tid)) == tStudent(tid);
      allow create: if studentChatWrite(tid, request.resource.data.keys(), 0);
      allow update: if studentChatWrite(tid, request.resource.data.diff(resource.data).affectedKeys(), resource.data.get('coachUnread', 0));
      match /messages/{id} {
        allow read: if coachReads(tid) || studentIn(tid);
        allow create: if request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.get('author', '') is string && request.resource.data.get('author', '').size() <= 80
          && ((coachSends(tid) && request.resource.data.from == 'coach')
            || (studentIn(tid) && request.resource.data.from == 'student'
                && request.resource.data.uid == request.auth.uid));
        // Sensei edit Sensei messages; the student edits their own.
        allow update: if validEdit()
          && ((coachSends(tid) && resource.data.from == 'coach')
            || (studentIn(tid) && resource.data.from == 'student' && resource.data.uid == request.auth.uid));
        allow delete: if coachReads(tid);
      }
    }

    // Group chat and training journal: every accepted student and Sensei can read and post.
    // Only Sensei can send notices (above). Authors can edit their messages; authors and Sensei can delete them.
    match /channels/{ch}/messages/{id} {
      allow read: if ch in ['group', 'journal'] && (isStudent() || isCoach());
      allow create: if ch in ['group', 'journal']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && ((isCoach() && request.resource.data.from == 'coach')
          || (isStudent() && request.resource.data.from == 'student' && request.resource.data.uid == request.auth.uid));
      allow update: if ch in ['group', 'journal'] && validEdit()
        && ((isCoach() && resource.data.from == 'coach')
          || (isStudent() && resource.data.from == 'student' && resource.data.uid == request.auth.uid));
      allow delete: if isCoach() || (isStudent() && resource.data.uid == request.auth.uid);
    }

    // Sensei's homework: for one student (student = their uid) or a group (student = '').
    // Students read only their own; they tick it off in their own users/{uid}.homeworkDone.
    match /homework/{id} {
      allow read: if isCoach()
        || (isStudent() && (resource.data.student == request.auth.uid
            || (resource.data.student == '' && resource.data.audience in myAudiences())));
      allow write: if isCoach() && request.resource.data.title is string && request.resource.data.title.size() <= 120;
      allow delete: if isCoach();
    }

    // Yearly calendars: public to read, coaches publish.
    match /calendars/{year} {
      allow read: if true;
      allow write: if isCoach();
    }

    // Payment records: Sensei adds them (cash etc.) and the paypalIpn function adds PayPal ones.
    // Students can read their own.
    match /payments/{id} {
      allow read: if isCoach() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isCoach() && request.resource.data.amount is number && request.resource.data.month is string;
      allow delete: if isCoach();
    }

    // Fees and PayPal account for the student app's Pay page: Sensei sets them.
    match /settings/payments {
      allow read: if signedIn();
      allow write: if isCoach();
    }

    // Attendance register: Sensei mark who came; each student reads the days they attended.
    match /attendance/{date} {
      allow read: if isCoach() || (signedIn() && request.auth.uid in resource.data.present);
      allow write: if isCoach() && date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.keys().hasOnly(['date', 'month', 'present', 'by', 'updatedAt'])
        && request.resource.data.date == date && request.resource.data.month == date[0:7]
        && request.resource.data.present is list && request.resource.data.present.size() <= 500;
      allow delete: if isCoach();
    }

    // Days a register was taken (no names): any accepted student can see them, to mark days they missed.
    match /registerDays/{date} {
      allow read: if isCoach() || isStudent();
      allow write: if isCoach() && request.resource.data.keys().hasOnly(['date']) && request.resource.data.date == date;
      allow delete: if isCoach();
    }

    // Medals: Sensei award them to students; each student reads their own.
    match /awards/{id} {
      allow read: if isCoach() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isCoach()
        && request.resource.data.keys().hasOnly(['uid', 'studentName', 'title', 'medal', 'note', 'from', 'createdAt'])
        && request.resource.data.uid is string
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.medal in ['gold', 'silver', 'bronze', 'trophy', 'star']
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 300;
      allow delete: if isCoach();
    }

    // Student licences: Sensei keep each student's details and belt record; the student can read it.
    match /licences/{uid} {
      allow read: if isCoach() || (signedIn() && request.auth.uid == uid);
      allow write: if isCoach()
        && request.resource.data.keys().hasOnly(['address', 'membershipNo', 'startDate', 'renewal', 'status', 'authenticatedBy', 'record', 'updatedAt'])
        && request.resource.data.get('record', {}) is map && request.resource.data.get('record', {}).size() <= 11;
    }

    // Each Sensei's devices for push notifications (read only by the Cloud Functions otherwise).
    match /coachDevices/{uid} {
      allow read, delete: if isCoach() && request.auth.uid == uid;
      allow create, update: if isCoach() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'pushTokens', 'updatedAt'])
        && request.resource.data.email == email()
        && request.resource.data.pushTokens is list && request.resource.data.pushTokens.size() <= 20;
    }

    // Coach list: coaches manage it.
    match /settings/coaches {
      allow read: if signedIn();
      allow write: if isCoach();
    }
  }
}
